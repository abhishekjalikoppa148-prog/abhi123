# ==============================================================================
# CelebrationCraft — Environment Variables Template (Supabase Architecture)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# 
# ⚠️ CRITICAL SECURITY WARNING:
# NEVER commit .env or .env.local to GitHub.
# GitHub must only store code and configuration templates.
# Real credentials must remain in local .env.local or Vercel Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (PostgreSQL + Auth + Storage)
# ------------------------------------------------------------------------------
# Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Publishable Key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (SERVER-SIDE ONLY - NEVER expose to browser)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Storage Buckets (created automatically in migration)
SUPABASE_MEDIA_BUCKET=website-media
SUPABASE_PROFILE_BUCKET=profile-images

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT / Cookie Session)
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-generate-random-32-chars
AUTH_SECRET=your-auth-secret

# ------------------------------------------------------------------------------
# 3. OPENAI INTEGRATION (AI Birthday Messages)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@celebrationcraft.com

# ------------------------------------------------------------------------------
# 6. APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. CRON & MAINTENANCE (Optional)
# ------------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-for-scheduled-jobs
