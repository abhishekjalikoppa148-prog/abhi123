# ==========================================
# CelebrationCraft - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
.next/
/out/
dist/
build/
coverage/
.vercel/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Temporary files
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo

# IDE / Editor configuration
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts
